<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="hr_loan_sequence" model="ir.sequence">
        <field name="name">Employee Loan</field>
        <field name="code">hr.loan.fx</field>
        <field name="prefix">LOAN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- نوع الإدخال (Other Input) الذي سيقرأه Salary Rule الخصم -->
    <record id="hr_payslip_input_type_loan" model="hr.payslip.input.type">
        <field name="name">استقطاع قسط قرض (LOAN)</field>
        <field name="code">LOAN</field>
    </record>

</odoo>
