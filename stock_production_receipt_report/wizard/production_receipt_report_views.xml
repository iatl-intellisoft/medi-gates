<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_receipt_report_wizard_form" model="ir.ui.view">
        <field name="name">production.receipt.report.wizard.form</field>
        <field name="model">production.receipt.report.wizard</field>
        <field name="arch" type="xml">
            <form string="تقرير المنتجات النازلة للمخزن من الإنتاج">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="product_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" type="object"
                            string="تصدير Excel" class="btn-primary"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_production_receipt_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير المنتجات النازلة للمخزن (إنتاج)</field>
        <field name="res_model">production.receipt.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_production_receipt_report"
              name="تقرير استلام الإنتاج (Excel)"
              parent="mrp.menu_mrp_reporting"
              action="action_production_receipt_report_wizard"
              sequence="50"/>

</odoo>
