<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_appraisal_kpi_category_list" model="ir.ui.view">
        <field name="name">sales.appraisal.kpi.category.list</field>
        <field name="model">sales.appraisal.kpi.category</field>
        <field name="arch" type="xml">
            <list string="KPI Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="max_rate"/>
                <field name="evaluator"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sales_appraisal_kpi_category_form" model="ir.ui.view">
        <field name="name">sales.appraisal.kpi.category.form</field>
        <field name="model">sales.appraisal.kpi.category</field>
        <field name="arch" type="xml">
            <form string="KPI Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="evaluator"/>
                        </group>
                        <group>
                            <field name="max_rate"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPIs">
                            <field name="kpi_definition_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="max_rate" readonly="1"/>
                                    <field name="evaluator"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sales_appraisal_kpi_category" model="ir.actions.act_window">
        <field name="name">KPI Categories</field>
        <field name="res_model">sales.appraisal.kpi.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
