<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_appraisal_target_list" model="ir.ui.view">
        <field name="name">sales.appraisal.target.list</field>
        <field name="model">sales.appraisal.target</field>
        <field name="arch" type="xml">
            <list string="Monthly Collection Targets" editable="bottom">
                <field name="salesperson_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="collection_target" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sales_appraisal_target_form" model="ir.ui.view">
        <field name="name">sales.appraisal.target.form</field>
        <field name="model">sales.appraisal.target</field>
        <field name="arch" type="xml">
            <form string="Monthly Collection Target">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="collection_target" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sales_appraisal_target_search" model="ir.ui.view">
        <field name="name">sales.appraisal.target.search</field>
        <field name="model">sales.appraisal.target</field>
        <field name="arch" type="xml">
            <search string="Search Collection Targets">
                <field name="salesperson_id"/>
                <field name="month"/>
                <field name="year"/>
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="groupby_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Year" name="groupby_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_appraisal_target" model="ir.actions.act_window">
        <field name="name">Monthly Collection Targets</field>
        <field name="res_model">sales.appraisal.target</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
