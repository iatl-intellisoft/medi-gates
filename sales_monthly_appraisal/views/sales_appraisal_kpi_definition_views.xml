<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_appraisal_kpi_definition_list" model="ir.ui.view">
        <field name="name">sales.appraisal.kpi.definition.list</field>
        <field name="model">sales.appraisal.kpi.definition</field>
        <field name="arch" type="xml">
            <list string="KPI Definitions" editable="bottom">
                <field name="category_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="max_rate" readonly="1"/>
                <field name="evaluator"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sales_appraisal_kpi_definition_form" model="ir.ui.view">
        <field name="name">sales.appraisal.kpi.definition.form</field>
        <field name="model">sales.appraisal.kpi.definition</field>
        <field name="arch" type="xml">
            <form string="KPI Definition">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="evaluator"/>
                            <field name="weight"/>
                            <field name="max_rate" readonly="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description / Scoring Guidance">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sales_appraisal_kpi_definition_search" model="ir.ui.view">
        <field name="name">sales.appraisal.kpi.definition.search</field>
        <field name="model">sales.appraisal.kpi.definition</field>
        <field name="arch" type="xml">
            <search string="Search KPI Definitions">
                <field name="name"/>
                <field name="category_id"/>
                <filter string="Sales" name="filter_sales" domain="[('evaluator','=','sales')]"/>
                <filter string="Accounting" name="filter_accounting" domain="[('evaluator','=','accounting')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="groupby_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Evaluator" name="groupby_evaluator" context="{'group_by': 'evaluator'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_appraisal_kpi_definition" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">sales.appraisal.kpi.definition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_category': 1}</field>
    </record>

</odoo>
