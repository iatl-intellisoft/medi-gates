<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_appraisal_incentive_report_wizard_form" model="ir.ui.view">
        <field name="name">sales.appraisal.incentive.report.wizard.form</field>
        <field name="model">sales.appraisal.incentive.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Incentive Report">
                <group>
                    <field name="month"/>
                    <field name="year"/>
                </group>
                <footer>
                    <button name="action_print_excel" type="object"
                            string="Print Excel" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sales_appraisal_incentive_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Incentive Excel Report</field>
        <field name="res_model">sales.appraisal.incentive.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
 
</odoo>
