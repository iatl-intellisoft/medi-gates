<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_in_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.in.report.wizard.form</field>
        <field name="model">stock.in.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock In Report">
                <group invisible="state != 'choose'">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="warehouse_id"/>
                </group>

                <group invisible="state != 'done'">
                    <field name="file_name" invisible="1"/>
                    <field name="xlsx_file"
                           filename="file_name"
                           widget="binary"
                           readonly="1"/>
                </group>

                <footer>
                    <button name="action_generate_xlsx"
                            type="object"
                            string="Print Report"
                            class="btn-primary"
                            invisible="state != 'choose'"/>

                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_in_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock In Report (Excel)</field>
        <field name="res_model">stock.in.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_in_report_wizard"
              name="Stock In Report (Excel)"
              parent="stock.menu_warehouse_report"
              action="action_stock_in_report_wizard"
              sequence="50"/>

</odoo>
