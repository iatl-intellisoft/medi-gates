<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_appraisal_incentive_list" model="ir.ui.view">
        <field name="name">sales.appraisal.incentive.list</field>
        <field name="model">sales.appraisal.incentive</field>
        <field name="arch" type="xml">
            <list string="Monthly Collection Incentive" editable="bottom">
                <field name="salesperson_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_amount_collected" widget="monetary"/>
                <field name="total_kpi_rate" />
                <field name="total_amount_collected_by_kpi" />
                <field name="total_amount_collected_on_time" widget="monetary"/>
                <!-- <field name="on_time_kpi_rate" /> -->
                <field name="total_amount_collected_on_time_by_kpi" widget="monetary"/> 
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sales_appraisal_incentive_form" model="ir.ui.view">
        <field name="name">sales.appraisal.incentive.form</field>
        <field name="model">sales.appraisal.incentive</field>
        <field name="arch" type="xml">
            <form string="Monthly Collection incentive">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group>
                	    <field name="total_amount_collected" widget="monetary"/>
                	    <field name="total_kpi_rate" />
               	    	    <field name="total_amount_collected_on_time" widget="monetary"/>
                	    <!-- <field name="on_time_kpi_rate" /> -->
                	    <field name="currency_id" column_invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sales_appraisal_incentive_search" model="ir.ui.view">
        <field name="name">sales.appraisal.incentive.search</field>
        <field name="model">sales.appraisal.incentive</field>
        <field name="arch" type="xml">
            <search string="Search Collection incentive">
                <field name="salesperson_id"/>
                <field name="month"/>
                <field name="year"/>
                <group expand="0" string="Group By">
                    <filter string="Salesperson" name="groupby_salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter string="Year" name="groupby_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_appraisal_incentive" model="ir.actions.act_window">
        <field name="name">Monthly Collection Incentive</field>
        <field name="res_model">sales.appraisal.incentive</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
