<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.fx.form</field>
        <field name="model">hr.loan.fx</field>
        <field name="arch" type="xml">
            <form string="قرض موظف">
                <header>
                    <button name="action_approve" type="object" string="اعتماد" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="إلغاء"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="contract_id"/>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="company_currency_id" readonly="1"/>
                            <field name="loan_account_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="loan_amount"/>
                            <field name="number_of_installments"/>
                            <field name="installment_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_paid_currency" readonly="1"/>
                            <field name="balance_currency" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="جدول الأقساط">
                            <field name="loan_line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="amount_currency"/>
                                    <field name="amount_company_currency"/>
                                    <field name="exchange_rate"/>
                                    <field name="paid"/>
                                    <field name="payslip_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_loan_list" model="ir.ui.view">
        <field name="name">hr.loan.fx.list</field>
        <field name="model">hr.loan.fx</field>
        <field name="arch" type="xml">
            <list string="قروض الموظفين">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="currency_id"/>
                <field name="loan_amount"/>
                <field name="balance_currency"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">قروض الموظفين</field>
        <field name="res_model">hr.loan.fx</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_loan_root"
              name="القروض متعددة العملات"
              parent="hr.menu_hr_root"
              sequence="60"/>
    <menuitem id="menu_hr_loan"
              name="القروض"
              parent="menu_hr_loan_root"
              action="action_hr_loan"
              sequence="10"/>

</odoo>
